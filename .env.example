# Configuração do Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=guia_fotografo_casamento
DB_USERNAME=root
DB_PASSWORD=

# String de Conexão opcional (URL)
DATABASE_URL=mysql://root:@localhost:3306/guia_fotografo_casamento

# Chave de Autenticação JWT
JWT_SECRET=substitua_por_uma_chave_jwt_longa_e_aleatoria

# Chave mestra usada para criptografar VAPID e credenciais SMTP no MySQL.
# Gere um valor aleatório longo e mantenha-o somente no ambiente do servidor.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=substitua_por_uma_chave_aleatoria_com_32_bytes
